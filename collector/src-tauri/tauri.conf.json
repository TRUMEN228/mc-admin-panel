{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Mod Collector",
  "version": "1.0.0",
  "identifier": "local.mcmodcollector",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MC Mod Collector",
        "width": 1320,
        "height": 860,
        "minWidth": 940,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "MC Admin Panel",
    "shortDescription": "Сборщик модов Minecraft",
    "longDescription": "Подбор модов в сборку и обмен сборками с MC Admin Panel",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RTIwQkFCMkM5NDFEREEKUldUYUhaUXNxd3ZpUkgrd0NabDFSeDQ3ZEEvaHMzM3FDMm45YnA3SVZrUHJWdnZoRllOa25wR0cK",
      "endpoints": [
        "https://github.com/TRUMEN228/mc-admin-panel/releases/download/collector-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}