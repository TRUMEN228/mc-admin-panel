{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Admin Panel",
  "version": "2.0.0",
  "identifier": "local.mcadminpanel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MC Admin Panel",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "MC Admin Panel",
    "shortDescription": "Серверы Minecraft",
    "longDescription": "Админ-панель для создания и управления серверами Minecraft",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
