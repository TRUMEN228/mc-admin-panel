{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MC Admin Panel",
  "version": "2.2.1",
  "identifier": "local.mcadminpanel",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MC Admin Panel",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "transparent": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "publisher": "MC Admin Panel",
    "shortDescription": "Серверы Minecraft",
    "longDescription": "Админ-панель для создания и управления серверами Minecraft",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "template": "../installer/installer.nsi",
        "installerHooks": "../installer/panel.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0RTIwQkFCMkM5NDFEREEKUldUYUhaUXNxd3ZpUkgrd0NabDFSeDQ3ZEEvaHMzM3FDMm45YnA3SVZrUHJWdnZoRllOa25wR0cK",
      "endpoints": [
        "https://github.com/TRUMEN228/mc-admin-panel/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
